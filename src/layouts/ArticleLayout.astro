---
/**
 * One layout for posts, projects and awards: back link, header, optional
 * facts strip, the Markdown body, and links to the neighbouring entries.
 */
import BaseLayout from "./BaseLayout.astro";
import type { NavId } from "../components/SiteHeader.astro";
import Icon from "../components/Icon.astro";

export interface Neighbour {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  nav: NavId;
  back: { href: string; label: string };
  tag?: string;
  /** Mono line under the title, e.g. ["Jun 10, 2022", "2 min read"]. */
  meta?: string[];
  tags?: { label: string; href: string }[];
  facts?: { label: string; value: string }[];
  image?: string;
  /** Social card image; defaults to `image`. */
  ogImage?: string;
  prev?: Neighbour;
  next?: Neighbour;
  prevLabel?: string;
  nextLabel?: string;
}

const {
  title, description, nav, back, tag, meta = [], tags = [], facts = [], image, ogImage = image,
  prev, next, prevLabel = "Previous", nextLabel = "Next",
} = Astro.props;
---

<BaseLayout title={title} description={description} image={ogImage} nav={nav}>
  <a class="crumb" href={back.href}><Icon name="left" />{back.label}</a>
  <article>
    <header class="article-head">
      {tag && <div class="tag">{tag}</div>}
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {(meta.length > 0 || tags.length > 0) && (
        <div class="article-meta">
          {meta.map((item, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<span>{item}</span></>)}
          {tags.length > 0 && (
            <span class="chips">{tags.map((t) => <a class="chip" href={t.href}>{t.label}</a>)}</span>
          )}
        </div>
      )}
      {facts.length > 0 && (
        <dl class="facts" style={`--n: ${facts.length}`}>
          {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
      )}
      {image && <img class="article-image" src={image} alt="" loading="lazy" />}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  {(prev || next) && (
    <nav class="pager" aria-label="More">
      {prev && <a href={prev.href}><div class="dir">&larr; {prevLabel}</div><div class="t">{prev.title}</div></a>}
      {next && <a class="next" href={next.href}><div class="dir">{nextLabel} &rarr;</div><div class="t">{next.title}</div></a>}
    </nav>
  )}
</BaseLayout>

<script is:inline>
  // Wrap each code block with a header that names the language and copies the code.
  document.querySelectorAll(".prose pre.astro-code").forEach(function (pre) {
    var box = document.createElement("div");
    box.className = "code-block";
    var head = document.createElement("div");
    head.className = "code-head";
    var lang = document.createElement("span");
    lang.textContent = pre.dataset.language || "code";
    var btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = "Copy";
    btn.addEventListener("click", function () {
      var done = function () { btn.textContent = "Copied"; setTimeout(function () { btn.textContent = "Copy"; }, 1500); };
      if (navigator.clipboard) navigator.clipboard.writeText(pre.innerText).then(done, function () {});
    });
    head.append(lang, btn);
    pre.parentNode.insertBefore(box, pre);
    box.append(head, pre);
  });
</script>
