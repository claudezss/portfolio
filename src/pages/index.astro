---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopNav from "../components/home/TopNav.astro";
import HeroScene from "../components/home/HeroScene.astro";
import OrbBackground from "../components/home/OrbBackground.astro";
import AboutSection from "../components/home/AboutSection.astro";
import ExperienceTimeline from "../components/home/ExperienceTimeline.astro";
import SkillGroups from "../components/home/SkillGroups.astro";
import ProjectSwap from "../components/home/ProjectSwap.astro";
import type { ProjectCard } from "../components/home/ProjectSwap.astro";
import PublicationsAwards from "../components/home/PublicationsAwards.astro";
import type { Publication } from "../components/home/PublicationsAwards.astro";
import ContactSection from "../components/home/ContactSection.astro";

const projects: ProjectCard[] = [
  {
    tag: "Industry · GE Digital",
    title: "GridOS DERMS",
    desc: "Distributed energy resource management system: online power flow, DER dispatch, Volt/VAR optimization & CVR, hosting capacity, LMP and day-ahead market clearing.",
    linkLabel: "case study",
    url: "/project/gridos-derms",
    icon: "zap",
  },
  {
    tag: "Industry · DOE ENERGISE",
    title: "SCE Transactive Energy",
    desc: "First-of-its-kind transactive energy management software deployed at Southern California Edison for the DOE ENERGISE/EASE project.",
    linkLabel: "case study",
    url: "/project/sce-te",
    icon: "sun",
  },
  {
    tag: "Research · UofT ECE",
    title: "Wildfire Image Segmentation",
    desc: "U-Net built from scratch to segment burned areas from post-fire California satellite imagery — featured by UofT ECE.",
    linkLabel: "github",
    url: "https://github.com/ece1508-ai-alchemist/wildfire-segmentation",
    external: true,
    icon: "flame",
  },
  {
    tag: "Research · Multi-Agent RL",
    title: "Cooperative Driving — Highway-401",
    desc: "Multi-agent reinforcement learning for cooperative driving in HighwayEnv: agents learn to merge and yield together.",
    linkLabel: "github",
    url: "https://github.com/ece1508-ai-alchemist/highway-agent-401",
    external: true,
    icon: "car",
  },
];

const publications: Publication[] = [
  {
    year: "2025",
    title: "Grid-Agent: An LLM-Powered Multi-Agent System for Power Grid Control",
    venue: "ArXiv preprint",
    url: "https://arxiv.org/abs/2508.05702",
  },
  {
    year: "2022",
    title:
      "Three-Phase Distribution Locational Marginal Pricing for Competitive Electricity Markets with Distributed Generators and Flexible Loads",
    venue: "IEEE PES Innovative Smart Grid Technologies (ISGT)",
    url: "https://ieeexplore.ieee.org/abstract/document/9817498",
  },
];
---

<BaseLayout fullWidth={true} sideBarActiveItemID="home">
  <TopNav />
  <HeroScene />
  <OrbBackground />
  <AboutSection />
  <ExperienceTimeline />
  <SkillGroups />
  <ProjectSwap projects={projects} />
  <PublicationsAwards publications={publications} />
  <ContactSection />
</BaseLayout>

<script>
  import "../scripts/home-anim.ts";
</script>
