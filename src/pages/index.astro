---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopNav from "../components/home/TopNav.astro";
import HeroScene from "../components/home/HeroScene.astro";
import AboutSection from "../components/home/AboutSection.astro";
import ExperienceTimeline from "../components/home/ExperienceTimeline.astro";
import SkillGroups from "../components/home/SkillGroups.astro";
import ProjectSwap from "../components/home/ProjectSwap.astro";
import PublicationsAwards from "../components/home/PublicationsAwards.astro";
import type { Publication } from "../components/home/PublicationsAwards.astro";
import LatestWriting from "../components/home/LatestWriting.astro";
import ContactSection from "../components/home/ContactSection.astro";

const publications: Publication[] = [
  {
    year: "2025",
    title: "Grid-Agent: An LLM-Powered Multi-Agent System for Power Grid Control",
    venue: "ArXiv preprint",
    url: "https://arxiv.org/abs/2508.05702",
  },
  {
    year: "2022",
    title:
      "Three-Phase Distribution Locational Marginal Pricing for Competitive Electricity Markets with Distributed Generators and Flexible Loads",
    venue: "IEEE PES Innovative Smart Grid Technologies (ISGT)",
    url: "https://ieeexplore.ieee.org/abstract/document/9817498",
  },
];
---

<BaseLayout fullWidth={true} sideBarActiveItemID="home">
  <TopNav />
  <HeroScene />
  <AboutSection />
  <ExperienceTimeline />
  <SkillGroups />
  <ProjectSwap />
  <PublicationsAwards publications={publications} />
  <LatestWriting />
  <ContactSection />
</BaseLayout>

<script>
  import "../scripts/home-anim.ts";
</script>
