---
import { render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getAwards, longDate } from "../../utils/collections";

export async function getStaticPaths() {
  const awards = await getAwards();
  return awards.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"award">;
}

const { entry } = Astro.props;
const award = entry.data;
const { Content } = await render(entry);
---

<ArticleLayout
  title={award.title}
  description={award.description}
  nav="home"
  back={{ href: "/award/", label: "All awards" }}
  tag="Award"
  meta={[longDate(award.pubDate)]}
  image={award.heroImage}
>
  <Content />
</ArticleLayout>
