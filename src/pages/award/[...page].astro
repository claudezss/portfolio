---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAwards } from "../../utils/collections";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getAwards(), { pageSize: 100 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="Awards" description="Awards and prizes." nav="home">
  <div class="page-head">
    <h1>Awards</h1>
  </div>
  {page.data.length === 0 ? (
    <p class="empty">No awards yet.</p>
  ) : (
    <div class="rows">
      {page.data.map((award) => (
        <a class="row" href={`/award/${award.id}`}>
          <span class="when">{award.data.pubDate.getUTCFullYear()}</span>
          <div class="what">
            <div class="title">{award.data.title}</div>
            <div class="sub">{award.data.description}</div>
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
