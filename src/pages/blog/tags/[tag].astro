---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TagFilter from "../../../components/blog/TagFilter.astro";
import PostList from "../../../components/blog/PostList.astro";
import { getCollection } from "astro:content";
import { groupPostsByTag } from "../../../utils/tags";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");
  const groups = groupPostsByTag(posts);
  // One route per unique slug.
  return groups.map((group) => ({
    params: { tag: group.slug },
    props: { group, groups, total: posts.length },
  }));
}) satisfies GetStaticPaths;

const { group, groups, total } = Astro.props;
const countLabel = `${group.posts.length} ${group.posts.length === 1 ? "post" : "posts"}`;
---

<BaseLayout title={`Posts tagged "${group.tag}"`} description={`Posts tagged ${group.tag}`} nav="writing">
  <div class="page-head">
    <h1>Writing</h1>
    <p>{countLabel} tagged {group.tag}. <a class="link" href="/blog/">Show all</a></p>
    <TagFilter tags={groups} total={total} activeSlug={group.slug} />
  </div>

  <PostList posts={group.posts} />
</BaseLayout>
