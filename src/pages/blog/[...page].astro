---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagFilter from "../../components/blog/TagFilter.astro";
import PostList from "../../components/blog/PostList.astro";
import { groupPostsByTag } from "../../utils/tags";
import { getPosts } from "../../utils/collections";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPosts(), { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const all = await getPosts();
// Tag chips are built from every post, not only this page of them.
const tags = groupPostsByTag(all);
---

<BaseLayout title="Writing" description="Notes on machine learning, lectures, and small Python tools." nav="writing">
  <div class="page-head">
    <h1>Writing</h1>
    <p>Notes on machine learning, lectures I taught, and small Python tools.</p>
    <TagFilter tags={tags} total={all.length} />
  </div>

  <PostList posts={page.data} />

  {(page.url.prev || page.url.next) && (
    <nav class="pagination" aria-label="Pagination">
      {page.url.prev ? <a class="link" href={page.url.prev}>&larr; Newer</a> : <span />}
      <span>Page {page.currentPage} of {page.lastPage}</span>
      {page.url.next ? <a class="link" href={page.url.next}>Older &rarr;</a> : <span />}
    </nav>
  )}
</BaseLayout>
