---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import { education, roles } from "../data/experience";
import { skillGroups } from "../data/skills";
---

<BaseLayout title="CV" description="Yan Zhang: software and ML engineer, P.Eng." nav="cv">
  <div class="page-head">
    <h1>Curriculum vitae</h1>
    <p>Software and ML engineer, licensed P.Eng.</p>
  </div>

  <section>
    <SectionHead title="Experience" />
    {roles.map((role) => (
      <div class="cv-role">
        <span class="logo"><img src={role.logo} alt="" width="32" height="32" loading="lazy" /></span>
        <div>
          <div class="head">
            <div><b>{role.position}</b> <span class="org">· {role.company}</span></div>
            <span class="when">{role.startDate} – {role.endDate}</span>
          </div>
          {role.intro && <p>{role.intro}</p>}
          <ul>
            {role.details.map((detail) => <li set:html={detail} />)}
          </ul>
        </div>
      </div>
    ))}
  </section>

  <section class="section">
    <SectionHead title="Education" />
    {education.map((item) => (
      <div class="cv-role">
        <span class="logo"><img src={item.logo} alt="" width="32" height="32" loading="lazy" /></span>
        <div class="head">
          <div><b>{item.degree}</b> <span class="org">· {item.school}</span></div>
          <span class="when">{item.startDate} – {item.endDate}</span>
        </div>
      </div>
    ))}
  </section>

  <section class="section">
    <SectionHead title="Skills" />
    <dl class="kit">
      {skillGroups.map((group) => (
        <>
          <dt>{group.name}</dt>
          <dd class="chips">{group.skills.map((skill) => <span class="chip">{skill}</span>)}</dd>
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
