---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import LiveSites from "../../components/LiveSites.astro";
import { sites } from "../../data/sites";
import { getProjects } from "../../utils/collections";
import type { GetStaticPaths } from "astro";

// One page holds every project; the route keeps the old /project/ URL.
export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getProjects(), { pageSize: 100 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Group by the part of `tag` before " · ", e.g. "Industry", "Research".
const groups = new Map<string, typeof page.data>();
for (const project of page.data) {
  const name = project.data.tag?.split(" · ")[0] ?? "Other";
  groups.set(name, [...(groups.get(name) ?? []), project]);
}
---

<BaseLayout title="Projects" description="Products deployed at utilities, and research on AI for energy." nav="projects">
  <div class="page-head">
    <h1>Projects</h1>
    <p>Products deployed at real utilities, and research on what AI can do for energy.</p>
  </div>

  {[...groups].map(([name, projects]) => (
    <section class="group">
      <SectionHead title={name} />
      <div class="cards">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  ))}

  {sites.length > 0 && (
    <section class="group">
      <SectionHead title="Live products" />
      <LiveSites />
    </section>
  )}
</BaseLayout>
