---
import { render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getProjects } from "../../utils/collections";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<"project">;
  prev?: CollectionEntry<"project">;
  next?: CollectionEntry<"project">;
}

const { entry, prev, next } = Astro.props;
const project = entry.data;
const { Content } = await render(entry);
const link = (e?: CollectionEntry<"project">) => e && { href: `/project/${e.id}`, title: e.data.title.trim() };

const facts = [
  project.role && { label: "Role", value: project.role },
  project.period && { label: "Years", value: project.period },
  project.company && { label: "Company", value: project.company },
  project.stack && { label: "Stack", value: project.stack.join(" · ") },
].filter((f): f is { label: string; value: string } => Boolean(f));
---

<ArticleLayout
  title={project.title.trim()}
  description={project.description}
  nav="projects"
  back={{ href: "/project/", label: "All projects" }}
  tag={project.tag}
  facts={facts}
  ogImage={project.heroImage}
  prev={link(prev)}
  next={link(next)}
>
  <Content />
  {project.repoUrl && (
    <p><a href={project.repoUrl} target="_blank" rel="noopener">Source code on GitHub</a></p>
  )}
</ArticleLayout>
