---
import type { TagGroup } from "../../utils/tags";

interface Props {
  tags: TagGroup[];
  total: number;
  /** Slug of the tag page being viewed; omitted on /blog/. */
  activeSlug?: string;
}

const { tags, total, activeSlug } = Astro.props;
---

<nav class="chips tags" aria-label="Filter posts by tag">
  <a class="chip" href="/blog/" aria-current={activeSlug ? undefined : "page"}>All<span class="count">{total}</span></a>
  {tags.map((group) => (
    <a class="chip" href={`/blog/tags/${group.slug}`} aria-current={group.slug === activeSlug ? "page" : undefined}>
      {group.tag}<span class="count">{group.posts.length}</span>
    </a>
  ))}
</nav>
