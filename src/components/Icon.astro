 */
import type { IconName } from "../data/social";

type Name = IconName | "arrow" | "left" | "moon" | "sun";

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className = "icon" } = Astro.props;

const brand: Record<string, [string, string]> = {
