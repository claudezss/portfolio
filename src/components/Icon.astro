---

{brand[name] ? (
  <svg class={className} viewBox={brand[name][0]} aria-hidden="true"><path fill="currentColor" d={brand[name][1]} /></svg>
) : (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {name === "mail" && <><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></>}
    {name === "arrow" && <path d="M7 17 17 7M8 7h9v9" />}
    {name === "left" && <path d="M19 12H5M11 18l-6-6 6-6" />}
    {name === "moon" && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
    {name === "sun" && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></>}
